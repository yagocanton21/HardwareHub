// Regras de limpeza. Referência: CleanCollection4 do Data.xml do Dism++ 10.1.1002.1B (73 regras), adaptadas para
// Windows 10/11 e programas comuns no Brasil. Itens só da China (QQ, 360, Baidu...) ficaram de fora.
// Arquivos em uso são ignorados; links e junções nunca são seguidos; raiz de disco e pastas pessoais são recusadas no motor.
//
// Campos extras (lidos em Core\Cleaner.cs):
//   "processos": se um desses programas estiver aberto, o item é pulado (ex.: navegador aberto) e a tela pede para fechar.
//   "programa":  nome mostrado nesse aviso ("Feche o Chrome para limpar").
//   "servicos":  serviços do Windows parados durante a limpeza e religados depois (só os que estavam rodando).
//   "aviso":     frase curta mostrada na faixa amarela quando o item está marcado (o que some de vez).
//   "especial":  lixeira | dism-componentes | restauracao-antigos | drivers-antigos | cleanmgr:<nome do item da Limpeza de Disco>
//   "{Steam}" no caminho: pasta onde a Steam está instalada (lida do registro).
[
  // ---------------- Arquivos temporários ----------------
  {
    "id": "temp-usuario",
    "categoria": "Arquivos temporários",
    "titulo": "Arquivos temporários do usuário",
    "descricao": "Arquivos que os programas criam para uso rápido e esquecem de apagar (pasta %TEMP%). Só apaga os que têm mais de 24 horas.",
    "nivel": "seguro",
    "recomendado": true,
    "alvos": [ { "caminho": "%TEMP%", "idadeMinimaHoras": 24 } ]
  },
  {
    "id": "temp-windows",
    "categoria": "Arquivos temporários",
    "titulo": "Arquivos temporários do Windows",
    "descricao": "Arquivos provisórios do próprio Windows (pasta C:\\Windows\\Temp). Só apaga os que têm mais de 24 horas.",
    "nivel": "seguro",
    "recomendado": true,
    "alvos": [ { "caminho": "%SystemRoot%\\Temp", "idadeMinimaHoras": 24 } ]
  },
  {
    "id": "temp-apps-store",
    "categoria": "Arquivos temporários",
    "titulo": "Temporários dos aplicativos da Microsoft Store",
    "descricao": "Arquivos provisórios que os aplicativos da Store (Fotos, WhatsApp, Calculadora...) deixam na pasta Temp de cada um. Só apaga os que têm mais de 24 horas.",
    "nivel": "seguro",
    "recomendado": true,
    "alvos": [ { "caminho": "%LOCALAPPDATA%\\Packages\\*\\AC\\Temp", "idadeMinimaHoras": 24 } ]
  },
  {
    "id": "temp-servicos",
    "categoria": "Arquivos temporários",
    "titulo": "Temporários dos serviços do Windows",
    "descricao": "Arquivos provisórios dos programas que o Windows roda escondido (serviços). Só apaga os que têm mais de 24 horas.",
    "nivel": "seguro",
    "recomendado": true,
    "alvos": [
      { "caminho": "%SystemRoot%\\ServiceProfiles\\*\\AppData\\Local\\Temp", "idadeMinimaHoras": 24 },
      { "caminho": "%SystemRoot%\\System32\\config\\systemprofile\\AppData\\Local\\Temp", "idadeMinimaHoras": 24 }
    ]
  },
  {
    "id": "lixeira",
    "categoria": "Arquivos temporários",
    "titulo": "Lixeira",
    "descricao": "Esvazia a Lixeira de todos os discos. Depois disso, o que estava lá não pode mais ser recuperado.",
    "nivel": "moderado",
    "especial": "lixeira",
    "aviso": "Lixeira: tudo o que está nela é apagado de vez e não volta."
  },
  {
    "id": "dumps",
    "categoria": "Arquivos temporários",
    "titulo": "Despejos de memória (tela azul e travamentos)",
    "descricao": "Arquivos .dmp criados em telas azuis, travamentos de programas e falhas do driver de vídeo. Guarde se estiver investigando um problema.",
    "nivel": "seguro",
    "recomendado": true,
    "alvos": [
      { "caminho": "%SystemRoot%\\Minidump", "padrao": "*.dmp" },
      { "caminho": "%SystemRoot%\\MEMORY.DMP" },
      { "caminho": "%SystemRoot%\\LiveKernelReports", "padrao": "*.dmp" },
      { "caminho": "%LOCALAPPDATA%\\CrashDumps", "padrao": "*.dmp" }
    ]
  },


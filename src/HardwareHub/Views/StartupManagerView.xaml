<UserControl x:Class="HardwareHub.Views.StartupManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#202023" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderBrush" Value="#2E2E33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#FAFAFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="Gerenciador de Inicialização do Windows" FontSize="22" FontWeight="Bold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                <TextBlock FontSize="12.5" Foreground="#A1A1AA" Margin="0,2,0,0" TextWrapping="Wrap">
                    <Run Text="Ativos: " />
                    <Run Text="{Binding ActiveStartupCount, Mode=OneWay}" Foreground="#FAFAFA" FontWeight="Bold" />
                    <Run Text="  •  Seguros para desativar agora: " />
                    <Run Text="{Binding SafeDisableStartupCount, Mode=OneWay}" Foreground="#34D399" FontWeight="Bold" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding RefreshStartupCommand}" Style="{StaticResource FlatButtonStyle}"
                        Background="#27272A" Foreground="#E4E4E7" Padding="12,8" BorderThickness="1" BorderBrush="#3F3F46" Margin="0,0,8,0">
                    <TextBlock Text="🔄 Atualizar" FontSize="12" FontWeight="SemiBold" />
                </Button>
                <Button Command="{Binding DisableRecommendedStartupCommand}" Style="{StaticResource FlatButtonStyle}"
                        Background="#059669" Foreground="#FFFFFF" Padding="14,8">
                    <TextBlock Text="⚡ Desligar Seguros" FontSize="12" FontWeight="Bold" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Barra de filtros e busca -->
        <Border Grid.Row="1" Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Command="{Binding SetStartupFilterCommand}" CommandParameter="Todos" Style="{StaticResource FilterPillStyle}">
                        <TextBlock Text="Todos" />
                    </Button>
                    <Button Command="{Binding SetStartupFilterCommand}" CommandParameter="Pode" Style="{StaticResource FilterPillStyle}">
                        <TextBlock Text="Pode desligar" />
                    </Button>
                    <Button Command="{Binding SetStartupFilterCommand}" CommandParameter="Ativos" Style="{StaticResource FilterPillStyle}">
                        <TextBlock Text="Ativos" />
                    </Button>
                    <Button Command="{Binding SetStartupFilterCommand}" CommandParameter="Desativados" Style="{StaticResource FilterPillStyle}">
                        <TextBlock Text="Desativados" />
                    </Button>
                </StackPanel>

                <TextBox Grid.Column="1" Text="{Binding StartupSearch, UpdateSourceTrigger=PropertyChanged}"
                         Background="#18181B" Foreground="#FAFAFA" CaretBrush="#FAFAFA"
                         BorderBrush="#3F3F46" BorderThickness="1" Padding="10,6" FontSize="12.5"
                         ToolTip="Filtrar por nome, fabricante ou origem" />
            </Grid>
        </Border>

        <!-- Banner -->
        <Border Grid.Row="2" Margin="0,0,0,12" Padding="12,10" CornerRadius="10"
                Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1"
                Visibility="{Binding HasStartupBanner, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding StartupStatusBanner}" Foreground="#E0E7FF" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                             Foreground="#818CF8" Background="#312E81" BorderThickness="0"
                             Visibility="{Binding IsBusyStartup, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Lista de entradas -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding FilteredStartupEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#FAFAFA" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" />
                                        <Border Background="{Binding AdviceColor}" CornerRadius="5" Padding="7,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding AdviceLabel}" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" />
                                        </Border>
                                        <Border Background="{Binding StatusColor}" CornerRadius="5" Padding="7,2">
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold" />
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Foreground="#A1A1AA" FontSize="11.5" Margin="0,4,0,0">
                                        <Run Text="{Binding Publisher, Mode=OneWay}" />
                                        <Run Text="  •  " />
                                        <Run Text="{Binding Origin, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Text="{Binding Description}" Foreground="#D4D4D8" FontSize="12"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding FilePath}" Foreground="#71717A" FontSize="10.5" FontFamily="Consolas"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" IsEnabled="{Binding CanInteract}"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46" BorderThickness="1"
                                        Padding="14,8" MinWidth="92" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActionButtonText}" FontSize="12" FontWeight="Bold" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>


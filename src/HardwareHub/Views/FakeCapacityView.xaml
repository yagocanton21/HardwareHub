<UserControl x:Class="HardwareHub.Views.FakeCapacityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="#FAFAFA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Background" Value="#202023" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderBrush" Value="#2E2E33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="#312E81" />
                    <Setter Property="BorderBrush" Value="#6366F1" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER FIXO -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="Detector de Capacidade Falsa (USB / SD)" FontSize="24" FontWeight="Bold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                <TextBlock Text="Detecte pendrives, cartões SD e SSDs falsificados com verificação de integridade SHA-256 sem apagar seus arquivos"
                           FontSize="12.5" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="🔄 Atualizar Unidades"
                        Command="{Binding RefreshDrivesCommand}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1"
                        FontSize="12.5" FontWeight="SemiBold" Padding="14,9" Margin="0,0,8,0" />
                <Button Content="▶ Iniciar Verificação"
                        Command="{Binding StartProbeCommand}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#4F46E5" Foreground="#FFFFFF"
                        FontSize="12.5" FontWeight="SemiBold" Padding="14,9" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <!-- SELEÇÃO DE UNIDADE + MODO DE TESTE -->
                <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Unidade Removível Alvo (discos internos do Windows são bloqueados por segurança)"
                                   FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,10" TextWrapping="Wrap" />

                        <ComboBox ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedDrive}"
                                  DisplayMemberPath="DisplayTitle" Padding="10,8" FontSize="13" Margin="0,0,0,10" />

                        <Border Background="#451A03" BorderBrush="#B45309" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding HasSelectedDriveBlockReason, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedDriveBlockReason}" Foreground="#FDE68A" FontSize="12.5" TextWrapping="Wrap" />
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Amostra de verificação:" Foreground="#A1A1AA" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Content="32 MB (Rápido)" Style="{StaticResource PresetButtonStyle}"
                                        Tag="{Binding IsPreset32Selected}" Command="{Binding SetSampleSizeCommand}" CommandParameter="32" />
                                <Button Content="128 MB (Padrão)" Style="{StaticResource PresetButtonStyle}"
                                        Tag="{Binding IsPreset128Selected}" Command="{Binding SetSampleSizeCommand}" CommandParameter="128" />
                                <Button Content="512 MB (Profundo)" Style="{StaticResource PresetButtonStyle}"
                                        Tag="{Binding IsPreset512Selected}" Command="{Binding SetSampleSizeCommand}" CommandParameter="512" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✖ Cancelar Teste"
                                    Command="{Binding CancelProbeCommand}"
                                    Visibility="{Binding IsBusyProbe, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Background="#7F1D1D" Foreground="#FEE2E2"
                                    FontSize="12" FontWeight="SemiBold" Padding="12,8" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BARRA DE PROGRESSO -->
                <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding ProgressStage}" Foreground="#E4E4E7" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                     Height="10" Margin="0,10,0,0" Foreground="#4F46E5" Background="#27272A" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- RESULTADO & MAPA DE BLOCOS -->
                <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16"
                        Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Background="{Binding LastReport.VerdictColor}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding LastReport.VerdictLabel}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock FontSize="12.5" Foreground="#F4F4F5" Margin="0,3,0,0">
                                    <Run Text="Capacidade real confirmada na amostra: " />
                                    <Run Text="{Binding RealCapacityFormatted, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding SpeedSummaryText}" Foreground="#D4D4D8" FontSize="12.5" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatsSummaryText}" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />

                        <TextBlock Text="Mapa Visual de Blocos Testados" FontSize="12.5" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding PointVisuals}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="14" Height="14" CornerRadius="3" Margin="2"
                                            Background="{Binding Color}" ToolTip="{Binding Tooltip}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>


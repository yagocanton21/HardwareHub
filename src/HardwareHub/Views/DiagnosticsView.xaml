<UserControl x:Class="HardwareHub.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="#FAFAFA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#202023" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderBrush" Value="#2E2E33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#FAFAFA" />
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#312E81" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER FIXO -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="Diagnóstico de Bateria &amp; Periféricos" FontSize="24" FontWeight="Bold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                <TextBlock Text="Relatório de desgaste da bateria, testador interativo de teclado ABNT2, mouse e dead pixels em tela cheia"
                           FontSize="12.5" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="🔋 Atualizar Bateria"
                        Command="{Binding RefreshBatteryCommand}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#4F46E5" Foreground="#FFFFFF"
                        Padding="14,9" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- SUB-TABS -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Style="{StaticResource SubTabButtonStyle}"
                    Content="🔋 Saúde da Bateria"
                    Tag="{Binding IsBatteryTabActive}"
                    Command="{Binding SetSubTabCommand}" CommandParameter="Battery" />
            <Button Style="{StaticResource SubTabButtonStyle}"
                    Content="⌨ Teclado ABNT2 &amp; Mouse"
                    Tag="{Binding IsPeripheralsTabActive}"
                    Command="{Binding SetSubTabCommand}" CommandParameter="Peripherals" />
            <Button Style="{StaticResource SubTabButtonStyle}"
                    Content="🖥 Tela &amp; Dead Pixel"
                    Tag="{Binding IsDisplayTabActive}"
                    Command="{Binding SetSubTabCommand}" CommandParameter="Display" />
        </WrapPanel>

        <!-- ================= SUB-TAB 1: BATERIA ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                      Visibility="{Binding IsBatteryTabActive, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Border Background="#1C1C22" BorderBrush="#312E81" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <ProgressBar DockPanel.Dock="Right" Width="130" Height="6" IsIndeterminate="True"
                                     Visibility="{Binding IsBusyBattery, Converter={StaticResource BoolToVis}}"
                                     VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding BatteryStatusBanner}" Foreground="#C7D2FE" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Veredito principal -->
                <Border Background="#18181B" BorderBrush="{Binding BatteryHealthColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{Binding BatteryVerdictText}" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BatteryMetaText}" FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BatteryLiveStatusText, StringFormat='Estado atual: {0}'}" FontSize="12" Foreground="#A5B4FC" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding BatteryHealthText}" FontSize="28" FontWeight="Bold" Foreground="{Binding BatteryHealthColor}" HorizontalAlignment="Right" />
                            <TextBlock Text="Saúde da bateria" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Métricas em cards -->
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <Border Background="#18181B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Capacidade Original" FontSize="11.5" Foreground="#A1A1AA" />
                            <TextBlock Text="{Binding BatteryDesignCapacityText}" FontSize="17" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#18181B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Carga Máxima Atual" FontSize="11.5" Foreground="#A1A1AA" />
                            <TextBlock Text="{Binding BatteryFullChargeText}" FontSize="17" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#18181B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Desgaste / Ciclos" FontSize="11.5" Foreground="#A1A1AA" />
                            <TextBlock Text="{Binding BatteryWearText}" FontSize="17" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding BatteryCycleCountText, StringFormat='Ciclos: {0}'}" FontSize="11" Foreground="#71717A" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#18181B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Autonomia Estimada" FontSize="11.5" Foreground="#A1A1AA" />
                            <TextBlock Text="{Binding BatteryEstimatedRuntimeText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#E4E4E7" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Histórico -->
                <Border Background="#18181B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Histórico de Capacidade Registrado pelo Windows" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding BatteryHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#202025" CornerRadius="6" Padding="10,7" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="#A1A1AA" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding FullChargeMwh, StringFormat='{}{0:N0} mWh de carga máxima'}" Foreground="#E4E4E7" FontSize="12" />
                                            <TextBlock Grid.Column="2" Text="{Binding HealthPercent, StringFormat='{}{0:0.0}%'}" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= SUB-TAB 2: TECLADO ABNT2 & MOUSE ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                      Visibility="{Binding IsPeripheralsTabActive, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Testador de Teclado ABNT2 -->
                <Border x:Name="KeyboardTesterSurface"
                        Focusable="True"
                        MouseDown="KeyboardSurface_MouseDown"
                        PreviewKeyDown="KeyboardSurface_PreviewKeyDown"
                        PreviewKeyUp="KeyboardSurface_PreviewKeyUp"
                        Background="#18181B" BorderBrush="#2E2E33" BorderThickness="1"
                        CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Testador Interativo de Teclado (ABNT2)" FontSize="14.5" FontWeight="Bold" Foreground="#FAFAFA" />
                                <TextBlock Text="{Binding LastPressedKeyText}" FontSize="12" Foreground="#A5B4FC" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KeyboardProgressText}" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Content="🎯 Focar Teclado" Click="FocusKeyboardButton_Click"
                                        Style="{StaticResource FlatButtonStyle}" Background="#312E81" Foreground="#FFFFFF"
                                        Padding="10,6" Margin="0,0,6,0" FontSize="11.5" />
                                <Button Content="Resetar" Command="{Binding ResetKeyboardCommand}"
                                        Style="{StaticResource FlatButtonStyle}" Background="#27272A" Foreground="#E4E4E7"
                                        Padding="10,6" FontSize="11.5" />
                            </StackPanel>
                        </Grid>

                        <!-- Linhas do teclado -->
                        <ItemsControl ItemsSource="{Binding KeyboardRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}" Margin="0,0,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding VisualWidth}" Height="34" Margin="0,0,4,0"
                                                        CornerRadius="5" BorderBrush="#3F3F46" BorderThickness="1"
                                                        Background="{Binding BackgroundHex}">
                                                    <TextBlock Text="{Binding Label}" Foreground="#FAFAFA" FontSize="10.5"
                                                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Testador de Mouse -->
                <Border Background="#18181B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Testador de Mouse (Botões, Scroll e Polling Rate)" FontSize="14.5" FontWeight="Bold" Foreground="#FAFAFA" />
                                <TextBlock Text="{Binding LastMouseEventText}" FontSize="12" Foreground="#A5B4FC" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Zerar Contadores" Command="{Binding ResetMouseCommand}"
                                    Style="{StaticResource FlatButtonStyle}" Background="#27272A" Foreground="#E4E4E7"
                                    Padding="10,6" FontSize="11.5" VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#121217" BorderBrush="#4F46E5" BorderThickness="1"
                                    CornerRadius="10" Height="150" Cursor="Cross"
                                    MouseDown="MouseTestPad_MouseDown"
                                    MouseWheel="MouseTestPad_MouseWheel"
                                    MouseMove="MouseTestPad_MouseMove">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🖱 Área de Teste do Mouse" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" HorizontalAlignment="Center" />
                                    <TextBlock Text="Clique com botões esquerdo, direito, scroll, laterais (X1/X2)&#x0a;ou mova o cursor para medir Polling Rate (Hz)"
                                               FontSize="11.5" Foreground="#A1A1AA" TextAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <UniformGrid Grid.Column="2" Columns="2" Rows="4">
                                <Border Background="#202025" CornerRadius="6" Padding="8" Margin="0,0,6,6">
                                    <StackPanel>
                                        <TextBlock Text="Botão Esquerdo" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock Text="{Binding LeftClicks}" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#202025" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Botão Direito" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock Text="{Binding RightClicks}" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#202025" CornerRadius="6" Padding="8" Margin="0,0,6,6">
                                    <StackPanel>
                                        <TextBlock Text="Scroll Clique / Cima" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#34D399">
                                            <Run Text="{Binding MiddleClicks, Mode=OneWay}" />
                                            <Run Text=" / ↑" />
                                            <Run Text="{Binding WheelUpTicks, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="#202025" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Scroll Baixo / Laterais" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#34D399">
                                            <Run Text="↓" />
                                            <Run Text="{Binding WheelDownTicks, Mode=OneWay}" />
                                            <Run Text=" / X1:" />
                                            <Run Text="{Binding X1Clicks, Mode=OneWay}" />
                                            <Run Text=" X2:" />
                                            <Run Text="{Binding X2Clicks, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="#202025" CornerRadius="6" Padding="8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Polling Atual" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock Text="{Binding CurrentPollingHz, StringFormat='{}{0} Hz'}" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#202025" CornerRadius="6" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="Pico Medido" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock Text="{Binding PeakPollingHz, StringFormat='{}{0} Hz'}" FontSize="15" FontWeight="Bold" Foreground="#A5B4FC" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= SUB-TAB 3: TELA & DEAD PIXEL ================= -->
        <Grid Grid.Row="2" Visibility="{Binding IsDisplayTabActive, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#18181B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Detector de Dead Pixel, Stuck Pixel &amp; Vazamento de Backlight" FontSize="14.5" FontWeight="Bold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DisplayColorCaption}" FontSize="12" Foreground="#A5B4FC" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="◀ Anterior" Command="{Binding PrevPixelColorCommand}"
                                Style="{StaticResource FlatButtonStyle}" Background="#27272A" Foreground="#E4E4E7"
                                Padding="11,8" Margin="0,0,6,0" FontSize="12" />
                        <Button Content="Próxima ▶" Command="{Binding NextPixelColorCommand}"
                                Style="{StaticResource FlatButtonStyle}" Background="#27272A" Foreground="#E4E4E7"
                                Padding="11,8" Margin="0,0,8,0" FontSize="12" />
                        <Button Content="🖥 Abrir em Tela Cheia" Click="LaunchFullscreenPixelTest_Click"
                                Style="{StaticResource FlatButtonStyle}" Background="#4F46E5" Foreground="#FFFFFF"
                                Padding="14,8" FontWeight="SemiBold" FontSize="12.5" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{Binding CurrentPixelColorHex}" BorderBrush="#3F3F46" BorderThickness="1"
                    CornerRadius="12" Cursor="Hand" MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown">
                <Border Background="#9909090B" CornerRadius="8" Padding="14,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPixelColorName, StringFormat='Prévia: {0} (clique aqui ou abra em Tela Cheia)'}"
                               Foreground="#FAFAFA" FontSize="14" FontWeight="SemiBold" />
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>


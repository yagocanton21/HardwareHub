<UserControl x:Class="HardwareHub.Views.DiskOptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="#FAFAFA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER FIXO -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="Otimização &amp; TRIM de Discos" FontSize="24" FontWeight="Bold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                <TextBlock Text="Audite TRIM de SSDs, tarefa semanal do Windows e execute ReTrim ou desfragmentação por unidade NTFS"
                           FontSize="12.5" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="📊 Medir Fragmentação"
                        Command="{Binding AnalyzeAllCommand}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1"
                        FontSize="12.5" FontWeight="SemiBold" Padding="14,9" Margin="0,0,8,0" />
                <Button Content="🔄 Atualizar Discos"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#4F46E5" Foreground="#FFFFFF"
                        FontSize="12.5" FontWeight="SemiBold" Padding="14,9" />
            </StackPanel>
        </Grid>

        <!-- AUDITORIA TRIM / AGENDAMENTO / PROTEÇÃO -->
        <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Background="#27272A" CornerRadius="6" Padding="10,6" Margin="0,0,8,4">
                        <TextBlock Text="{Binding TrimStatusLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7" />
                    </Border>
                    <Border Background="#27272A" CornerRadius="6" Padding="10,6" Margin="0,0,8,4">
                        <TextBlock Text="{Binding ScheduleStatusLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7" />
                    </Border>
                    <Border Background="#27272A" CornerRadius="6" Padding="10,6" Margin="0,0,8,4">
                        <TextBlock Text="{Binding ProtectionStatusLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7" />
                    </Border>
                </WrapPanel>
                <Button Grid.Column="1" Content="✅ Ligar Padrões Desativados"
                        Command="{Binding EnableDefaultsCommand}"
                        Visibility="{Binding HasMissingDefault, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#059669" Foreground="#FFFFFF"
                        FontSize="12.5" FontWeight="Bold" Padding="14,8" />
            </Grid>
        </Border>

        <!-- STATUS BANNER -->
        <Border Grid.Row="2" Background="#1C1C21" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusBanner}" Foreground="#D4D4D8" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="✖ Cancelar"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#7F1D1D" Foreground="#FEE2E2"
                        FontSize="12" FontWeight="SemiBold" Padding="12,6" Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- VOLUMES NTFS -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Volumes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14.5" FontWeight="Bold" Foreground="#FAFAFA" />
                                        <Border Background="{Binding MediaBadgeColor}" CornerRadius="5" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MediaBadge}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Model}" FontSize="12" Foreground="#71717A" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="#A5B4FC" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ActionButtonLabel}"
                                        Command="{Binding DataContext.OptimizeVolumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Background="#4F46E5" Foreground="#FFFFFF"
                                        FontSize="12.5" FontWeight="SemiBold" Padding="14,9" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>


<UserControl x:Class="HardwareHub.Views.ProgramsManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#202023" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderBrush" Value="#2E2E33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#FAFAFA" />
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#312E81" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgramListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBd" Background="#18181B" BorderBrush="#2E2E33"
                                BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#27272A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#232142" />
                                <Setter TargetName="ItemBd" Property="BorderBrush" Value="#6366F1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="Atualizações &amp; Desinstalador Profundo" FontSize="22" FontWeight="Bold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                <TextBlock Text="Atualize seus programas via Winget, remova aplicativos com busca inteligente de sobras e gerencie backups de registro."
                           FontSize="12.5" Foreground="#A1A1AA" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding RefreshProgramsCommand}" Style="{StaticResource FlatButtonStyle}"
                        Background="#27272A" Foreground="#E4E4E7" Padding="12,8" BorderThickness="1" BorderBrush="#3F3F46" Margin="0,0,8,0">
                    <TextBlock Text="🔄 Atualizar Lista" FontSize="12" FontWeight="SemiBold" />
                </Button>
                <Button Command="{Binding CheckUpdatesCommand}" Style="{StaticResource FlatButtonStyle}"
                        Background="#4F46E5" Foreground="#FFFFFF" Padding="14,8">
                    <TextBlock Text="🔍 Verificar Atualizações" FontSize="12" FontWeight="Bold" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Sub-abas -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Command="{Binding SwitchProgramsTabCommand}" CommandParameter="Updates"
                    Tag="{Binding IsUpdatesTab}" Style="{StaticResource SubTabButtonStyle}">
                <TextBlock Text="{Binding UpdatesCount, StringFormat='🔄 Atualizar Programas ({0})'}" />
            </Button>
            <Button Command="{Binding SwitchProgramsTabCommand}" CommandParameter="Uninstaller"
                    Tag="{Binding IsUninstallerTab}" Style="{StaticResource SubTabButtonStyle}">
                <TextBlock Text="{Binding ProgramsCount, StringFormat='🗑️ Desinstalador Profundo ({0})'}" />
            </Button>
            <Button Command="{Binding SwitchProgramsTabCommand}" CommandParameter="Backups"
                    Tag="{Binding IsBackupsTab}" Style="{StaticResource SubTabButtonStyle}">
                <TextBlock Text="{Binding UninstallBackups.Count, StringFormat='↩️ Backups de Desinstalação ({0})'}" />
            </Button>
        </StackPanel>

        <!-- Banner de Status + Progresso + Cancelar -->
        <Border Grid.Row="2" Margin="0,0,0,12" Padding="12,10" CornerRadius="10"
                Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1"
                Visibility="{Binding HasProgramsBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding ProgramsStatusBanner}" Foreground="#E0E7FF" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                                 Foreground="#818CF8" Background="#312E81" BorderThickness="0"
                                 Visibility="{Binding IsBusyPrograms, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CancelProgramsTaskCommand}" Style="{StaticResource FlatButtonStyle}"
                        Background="#DC2626" Foreground="#FFFFFF" Padding="12,6" VerticalAlignment="Center"
                        Visibility="{Binding IsBusyPrograms, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⏹ Cancelar" FontSize="11.5" FontWeight="Bold" />
                </Button>
            </Grid>
        </Border>

        <!-- ABA 1: ATUALIZADOR WINGET -->
        <Grid Grid.Row="3" Visibility="{Binding IsUpdatesTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding UpdateSearch, UpdateSourceTrigger=PropertyChanged}"
                             Background="#18181B" Foreground="#FAFAFA" CaretBrush="#FAFAFA"
                             BorderBrush="#3F3F46" BorderThickness="1" Padding="10,7" FontSize="12.5"
                             Margin="0,0,12,0" ToolTip="Filtrar atualizações por nome ou ID do Winget" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding SelectAllUpdatesCommand}" Style="{StaticResource FlatButtonStyle}"
                                Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1" Padding="10,7" Margin="0,0,6,0">
                            <TextBlock Text="{Binding SelectAllUpdatesLabel}" FontSize="11.5" FontWeight="SemiBold" />
                        </Button>
                        <Button Command="{Binding ClearIgnoredUpdatesCommand}" Style="{StaticResource FlatButtonStyle}"
                                Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1" Padding="10,7" Margin="0,0,6,0">
                            <TextBlock Text="👁️ Limpar Ignorados" FontSize="11.5" FontWeight="SemiBold" />
                        </Button>
                        <Button Command="{Binding UpgradeSelectedCommand}" Style="{StaticResource FlatButtonStyle}"
                                Background="#059669" Foreground="#FFFFFF" Padding="14,7">
                            <TextBlock Text="⬆️ Atualizar Selecionados" FontSize="12" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <ItemsControl ItemsSource="{Binding FilteredUpdates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanInteract}"
                                              VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="#FAFAFA" FontSize="13.5" FontWeight="Bold" />
                                            <Border Background="#27272A" CornerRadius="5" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Id}" Foreground="#A1A1AA" FontSize="10.5" FontFamily="Consolas" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding InstalledVersion, StringFormat='Instalada: {0}'}" Foreground="#A1A1AA" FontSize="11.5" />
                                            <TextBlock Text="  →  " Foreground="#71717A" FontSize="11.5" />
                                            <TextBlock Text="{Binding AvailableVersion, StringFormat='Disponível: {0}'}" Foreground="#34D399" FontSize="11.5" FontWeight="SemiBold" />
                                            <TextBlock Text="  •  " Foreground="#52525B" FontSize="11.5" />
                                            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}" FontSize="11.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.IgnoreUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" IsEnabled="{Binding CanInteract}"
                                                Style="{StaticResource FlatButtonStyle}"
                                                Background="#27272A" Foreground="#D4D4D8" BorderBrush="#3F3F46" BorderThickness="1"
                                                Padding="10,6" Margin="0,0,6,0">
                                            <TextBlock Text="Ignorar" FontSize="11.5" />
                                        </Button>
                                        <Button Command="{Binding DataContext.UpgradeSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" IsEnabled="{Binding CanInteract}"
                                                Style="{StaticResource FlatButtonStyle}"
                                                Background="#4F46E5" Foreground="#FFFFFF" Padding="12,6">
                                            <TextBlock Text="Atualizar" FontSize="11.5" FontWeight="Bold" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ABA 2: DESINSTALADOR PROFUNDO -->
        <Grid Grid.Row="3" Visibility="{Binding IsUninstallerTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Esquerda: Lista de Programas -->
            <Border Grid.Column="0" Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding ProgramsCount, StringFormat='Programas Instalados ({0})'}"
                               Foreground="#FAFAFA" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />

                    <TextBox Grid.Row="1" Text="{Binding ProgramSearch, UpdateSourceTrigger=PropertyChanged}"
                             Background="#18181B" Foreground="#FAFAFA" CaretBrush="#FAFAFA"
                             BorderBrush="#3F3F46" BorderThickness="1" Padding="10,7" FontSize="12.5"
                             Margin="0,0,0,10" ToolTip="Buscar programa por nome ou fabricante" />

                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredPrograms}"
                             SelectedItem="{Binding SelectedProgram, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ProgramListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" Foreground="#FAFAFA" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="#A1A1AA" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="{Binding Publisher, Mode=OneWay}" />
                                            <Run Text=" • v" />
                                            <Run Text="{Binding Version, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedSize}" Foreground="#D4D4D8" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding ScopeLabel}" Foreground="#71717A" FontSize="10.5" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Direita: Ações & Sobras -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Programa Selecionado" Foreground="#A1A1AA" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedProgram.Name, FallbackValue='Selecione um programa na lista ao lado'}"
                                   Foreground="#FAFAFA" FontSize="15" FontWeight="Bold" Margin="0,2,0,4" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasSelectedProgram, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedProgram.Publisher, StringFormat='Fabricante: {0}'}" Foreground="#A1A1AA" FontSize="11.5" />
                            <TextBlock Text="  •  " Foreground="#52525B" FontSize="11.5" />
                            <TextBlock Text="{Binding SelectedProgram.FormattedDate, StringFormat='Instalado: {0}'}" Foreground="#A1A1AA" FontSize="11.5" />
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nível da varredura:" Foreground="#D4D4D8" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LeftoverLevels}"
                                      SelectedItem="{Binding SelectedLeftoverLevel, Mode=TwoWay}"
                                      Background="#18181B" Foreground="#FAFAFA" BorderBrush="#3F3F46" Padding="8,5" />
                        </Grid>

                        <WrapPanel>
                            <Button Command="{Binding UninstallSelectedProgramCommand}" Style="{StaticResource FlatButtonStyle}"
                                    Background="#DC2626" Foreground="#FFFFFF" Padding="12,7" Margin="0,0,8,6">
                                <TextBlock Text="🗑️ Desinstalar" FontSize="12" FontWeight="Bold" />
                            </Button>
                            <Button Command="{Binding ScanLeftoversCommand}" Style="{StaticResource FlatButtonStyle}"
                                    Background="#4F46E5" Foreground="#FFFFFF" Padding="12,7" Margin="0,0,8,6">
                                <TextBlock Text="🔎 Buscar Sobras" FontSize="12" FontWeight="Bold" />
                            </Button>
                            <Button Command="{Binding ForceRemoveProgramEntryCommand}" Style="{StaticResource FlatButtonStyle}"
                                    Background="#27272A" Foreground="#FCA5A5" BorderBrush="#7F1D1D" BorderThickness="1" Padding="12,7" Margin="0,0,0,6">
                                <TextBlock Text="⚠️ Forçar Remoção da Entrada" FontSize="11.5" FontWeight="SemiBold" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Sobras encontradas -->
                <Border Grid.Row="1" Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="12" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LeftoversTitle}" Foreground="#E4E4E7" FontSize="12.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Command="{Binding CleanLeftoversCommand}" Style="{StaticResource FlatButtonStyle}"
                                    Background="#059669" Foreground="#FFFFFF" Padding="12,6"
                                    Visibility="{Binding HasLeftovers, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="🧹 Limpar Selecionados" FontSize="11.5" FontWeight="Bold" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FoundLeftovers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#18181B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#27272A" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding KindLabel}" Foreground="#D4D4D8" FontSize="10.5" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Background="{Binding LevelColor}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding LevelLabel}" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding FormattedSize}" Foreground="#A1A1AA" FontSize="10.5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayPath}" Foreground="#FAFAFA" FontSize="11.5" FontFamily="Consolas"
                                                               TextWrapping="Wrap" Margin="0,4,0,2" />
                                                    <TextBlock Text="{Binding Reason}" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ABA 3: BACKUPS DE DESINSTALAÇÃO -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsBackupsTab, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding UninstallBackups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" Foreground="#FAFAFA" FontSize="13.5" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Summary}" Foreground="#A1A1AA" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" IsEnabled="{Binding CanRestoreRegistry}"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Background="#4F46E5" Foreground="#FFFFFF" Padding="12,7" VerticalAlignment="Center">
                                    <TextBlock Text="↩️ Restaurar Registro (.reg)" FontSize="11.5" FontWeight="Bold" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>


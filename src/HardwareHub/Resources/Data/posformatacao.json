  // Ações únicas (rodam uma vez, em PowerShell). "verificar" devolve True quando já está feito.
  "acoes": [
    { "id": "windows-ptbr", "grupo": "Idioma, região e horário", "minutos": 10, "titulo": "Windows em português (Brasil)", "marcado": false, "reiniciar": "reboot",
      "descricao": "Baixa e ativa o idioma pt-BR do Windows. Os programas que seguem o idioma do Windows ficam em português. Pode levar alguns minutos.",
      "verificar": "(Get-WinUILanguageOverride).Name -eq 'pt-BR' -or ([Globalization.CultureInfo]::CurrentUICulture.Name -eq 'pt-BR')",
      "executar": "Import-Module LanguagePackManagement -ErrorAction Stop; Install-Language pt-BR -CopyToSettings -ErrorAction Stop | Out-Null; Set-WinUILanguageOverride -Language pt-BR" },
    { "id": "formato-ptbr", "grupo": "Idioma, região e horário", "minutos": 0.2, "titulo": "Data, hora e moeda no padrão brasileiro", "marcado": true,
      "descricao": "Datas em dd/mm/aaaa, vírgula nos decimais, R$ e região Brasil (para a Microsoft Store mostrar apps brasileiros).",
      "verificar": "(Get-Culture).Name -eq 'pt-BR' -and (Get-WinHomeLocation).GeoId -eq 32",
      "executar": "Set-Culture pt-BR; Set-WinHomeLocation -GeoId 32" },
    { "id": "teclado-abnt2", "grupo": "Idioma, região e horário", "minutos": 0.3, "titulo": "Teclado ABNT2 (com Ç)", "marcado": true,
      "descricao": "Adiciona o teclado brasileiro ABNT2 se o PC ainda não tiver um teclado brasileiro. Os layouts que você já tem continuam lá. Se o seu teclado é americano (sem Ç), desmarque.",
      // 0416:00020409 = português com teclado Estados Unidos-Internacional (notebook importado): já está configurado, não mexe
      "verificar": "$t = (Get-WinUserLanguageList).InputMethodTips; $t -contains '0416:00010416' -or $t -contains '0416:00000416' -or $t -contains '0416:00020409'",
      "executar": "$l = Get-WinUserLanguageList; $pt = $l | Where-Object LanguageTag -eq 'pt-BR'; if (-not $pt) { $l.Add('pt-BR'); $pt = $l | Where-Object LanguageTag -eq 'pt-BR' }; if ($pt.InputMethodTips -notcontains '0416:00010416') { $pt.InputMethodTips.Add('0416:00010416') }; Set-WinUserLanguageList $l -Force" },
    { "id": "relogio", "grupo": "Idioma, região e horário", "minutos": 0.2, "titulo": "Acertar o relógio pela internet", "marcado": true,
      "descricao": "Liga o serviço de horário do Windows e sincroniza agora. Relógio errado quebra sites com cadeado (HTTPS).",
      "executar": "Set-Service w32time -StartupType Automatic; Start-Service w32time; w32tm /resync /force | Out-Null" },
    { "id": "fuso-brasilia", "grupo": "Idioma, região e horário", "minutos": 0.1, "titulo": "Fuso horário de Brasília", "marcado": false,
      "descricao": "Só marque se você mora no horário de Brasília (SP, RJ, MG, Sul, Nordeste, GO, DF...).",
      "verificar": "(Get-TimeZone).Id -eq 'E. South America Standard Time'",
      "executar": "Set-TimeZone -Id 'E. South America Standard Time'" },
    { "id": "protecao-sistema", "grupo": "Segurança e energia", "minutos": 0.3, "titulo": "Ligar a Proteção do Sistema (pontos de restauração)", "marcado": true,
      "descricao": "Em PC recém-formatado ela costuma vir desligada. Com ela ligada, dá para voltar o Windows se algo der errado.",
      "verificar": "[bool](Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\SPP\\Clients' -ErrorAction SilentlyContinue).'{09F7EDC5-294E-4180-AF6A-FB0E6A0E9513}'",
      "executar": "Enable-ComputerRestore -Drive \"$env:SystemDrive\\\"" },
    { "id": "alto-desempenho", "grupo": "Segurança e energia", "minutos": 0.1, "titulo": "Plano de energia Alto desempenho", "marcado": false,
      "descricao": "Recomendado só para PC de mesa. Em notebook gasta mais bateria.",
      "verificar": "(powercfg /getactivescheme) -match '8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c'",
      "executar": "powercfg /setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c; if ($LASTEXITCODE -ne 0) { $g = (powercfg /duplicatescheme 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c) -replace '.*?([0-9a-f-]{36}).*', '$1'; powercfg /setactive $g }" }
  ]

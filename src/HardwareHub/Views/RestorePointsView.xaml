<UserControl x:Class="HardwareHub.Views.RestorePointsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="#FAFAFA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER FIXO -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="Pontos de Restauração" FontSize="24" FontWeight="Bold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                <TextBlock Text="Crie pontos de restauração com 1 clique, monitore o espaço usado pelo Shadow Copy e remova cópias antigas preservando a mais recente"
                           FontSize="12.5" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="⏮ Abrir rstrui.exe"
                        Command="{Binding OpenRestoreWizardCommand}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1"
                        FontSize="12.5" FontWeight="SemiBold" Padding="12,9" Margin="0,0,8,0" />
                <Button Content="🔄 Atualizar Lista"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#4F46E5" Foreground="#FFFFFF"
                        FontSize="12.5" FontWeight="SemiBold" Padding="14,9" />
            </StackPanel>
        </Grid>

        <!-- CARD PROTEÇÃO + CRIAR NOVO PONTO -->
        <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ProtectionStatus.StatusLabel}" FontSize="14" FontWeight="Bold" Foreground="#FAFAFA" />
                        <TextBlock Text="{Binding ProtectionStatus.UsageSummary}" FontSize="12.5" Foreground="#A1A1AA" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🛡 Ativar Proteção"
                                Command="{Binding EnableProtectionCommand}"
                                Visibility="{Binding ShowEnableProtectionButton, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#059669" Foreground="#FFFFFF"
                                FontSize="12.5" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" />
                        <Button Content="⚙ Configurar VSS"
                                Command="{Binding OpenProtectionSettingsCommand}"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1"
                                FontSize="12.5" FontWeight="SemiBold" Padding="12,8" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewPointDescription, UpdateSourceTrigger=PropertyChanged}"
                             Background="#111114" Foreground="#FAFAFA" BorderBrush="#3F3F46" BorderThickness="1"
                             Padding="12,9" FontSize="13" Margin="0,0,10,0" />
                    <Button Grid.Column="1" Content="➕ Criar Ponto de Restauração"
                            Command="{Binding CreatePointCommand}"
                            Style="{StaticResource FlatButtonStyle}"
                            Background="#059669" Foreground="#FFFFFF"
                            FontSize="12.5" FontWeight="Bold" Padding="14,9" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- STATUS BANNER -->
        <Border Grid.Row="2" Background="#1C1C21" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusBanner}" Foreground="#D4D4D8" FontSize="12.5" TextWrapping="Wrap" />
        </Border>

        <!-- LISTA DE PONTOS -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Points}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Description}" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                                    <TextBlock FontSize="12" Foreground="#A1A1AA" Margin="0,3,0,0">
                                        <Run Text="{Binding SequenceBadge, Mode=OneWay}" Foreground="#A5B4FC" />
                                        <Run Text=" • " />
                                        <Run Text="{Binding TypeLabel, Mode=OneWay}" />
                                        <Run Text=" • " />
                                        <Run Text="{Binding FormattedDate, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🗑 Remover"
                                        Command="{Binding DataContext.DeletePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Background="#7F1D1D" Foreground="#FEE2E2"
                                        FontSize="12" FontWeight="SemiBold" Padding="12,7" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>


<UserControl x:Class="HardwareHub.Views.WindowsHealthReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Saúde do Windows, Inventário &amp; Relatório" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                <TextBlock Text="Checagem não-destrutiva (DISM/SFC/WMI/NTP), reparos extras, módulos RAM/VRAM e relatório sem dados pessoais"
                           FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RunQuickHealthCheckCommand}" IsEnabled="{Binding CanExecuteActions}"
                        Background="#27272A" Foreground="#E4E4E7" FontWeight="SemiBold" FontSize="12"
                        Padding="14,9" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="⚡ Checagem Rápida" />
                </Button>
                <Button Command="{Binding RunFullHealthCheckCommand}" IsEnabled="{Binding CanExecuteActions}"
                        Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                        Padding="16,9" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="🔬 Checagem Completa" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Sub-abas -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Command="{Binding SelectSubTabCommand}" CommandParameter="Health" Margin="0,0,8,0" Padding="14,8" Cursor="Hand" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#202023" />
                        <Setter Property="Foreground" Value="#A1A1AA" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHealthTab}" Value="True">
                                <Setter Property="Background" Value="#312E81" />
                                <Setter Property="Foreground" Value="#E0E7FF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="🩺 Saúde &amp; Sugestões" />
            </Button>

            <Button Command="{Binding SelectSubTabCommand}" CommandParameter="Repairs" Margin="0,0,8,0" Padding="14,8" Cursor="Hand" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#202023" />
                        <Setter Property="Foreground" Value="#A1A1AA" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRepairsTab}" Value="True">
                                <Setter Property="Background" Value="#312E81" />
                                <Setter Property="Foreground" Value="#E0E7FF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="🛠️ Reparos Extras" />
            </Button>

            <Button Command="{Binding SelectSubTabCommand}" CommandParameter="Inventory" Margin="0,0,8,0" Padding="14,8" Cursor="Hand" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#202023" />
                        <Setter Property="Foreground" Value="#A1A1AA" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInventoryTab}" Value="True">
                                <Setter Property="Background" Value="#312E81" />
                                <Setter Property="Foreground" Value="#E0E7FF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="🧬 Inventário &amp; RAM" />
            </Button>

            <Button Command="{Binding SelectSubTabCommand}" CommandParameter="Report" Padding="14,8" Cursor="Hand" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#202023" />
                        <Setter Property="Foreground" Value="#A1A1AA" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReportTab}" Value="True">
                                <Setter Property="Background" Value="#312E81" />
                                <Setter Property="Foreground" Value="#E0E7FF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="📄 Exportar Relatório" />
            </Button>
        </StackPanel>

        <!-- Barra de status -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#E4E4E7" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ProgressBar Grid.Column="1" Width="120" Height="4" IsIndeterminate="True" Foreground="#818CF8" Background="#27272A"
                             BorderThickness="0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- SUB-ABA 1: SAÚDE & SUGESTÕES -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsHealthTab, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="INDICADORES DE INTEGRIDADE DO WINDOWS" FontSize="11" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding HealthItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                        <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="5" Padding="8,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="SUGESTÕES PROATIVAS" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,12,0,8" />
                <ItemsControl ItemsSource="{Binding Suggestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#18181B" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{Binding BadgeColor}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#A1A1AA" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding DataContext.OpenSuggestionTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#27272A" Foreground="#E4E4E7" FontWeight="SemiBold" FontSize="11"
                                            Padding="12,7" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="{Binding ActionLabel}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- SUB-ABA 2: REPAROS EXTRAS -->
        <Grid Grid.Row="3" Visibility="{Binding IsRepairsTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="140" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Reparos cirúrgicos adicionais do Windows (marque o que deseja executar)" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Command="{Binding ExecuteSelectedRepairsCommand}" IsEnabled="{Binding CanExecuteActions}"
                                Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Padding="16,8" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="🔧 Executar Selecionados" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RepairSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" />
                                                <TextBlock Text="{Binding EstimatedTime, StringFormat=' · {0}'}" Foreground="#71717A" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding CommandDisplay}" FontFamily="Consolas" FontSize="11" Foreground="#71717A" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding CautionNote}" FontSize="11" Foreground="#FBBF24" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Background="#0F0F11" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                <TextBox Text="{Binding RepairLogOutput, Mode=OneWay}" Background="Transparent" Foreground="#34D399"
                         FontFamily="Consolas" FontSize="11" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </Border>
        </Grid>

        <!-- SUB-ABA 3: INVENTÁRIO & RAM -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsInventoryTab, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Command="{Binding RefreshInventoryCommand}" IsEnabled="{Binding CanExecuteActions}"
                            Background="#27272A" Foreground="#E4E4E7" FontWeight="SemiBold" FontSize="12"
                            Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="🔄 Atualizar Inventário" />
                    </Button>
                    <Button Command="{Binding TrimRamCommand}" IsEnabled="{Binding CanExecuteActions}"
                            Background="#DB2777" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                            Padding="14,8" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="🚀 Liberar Memória RAM Ociosa" />
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding RamCleanupBanner}" Foreground="#F472B6" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="SISTEMA &amp; PLACA-MÃE" FontSize="11" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding SystemSummary}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding SystemLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="#71717A" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#E4E4E7" FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="#2E2E33" Margin="0,8" />
                            <TextBlock Text="{Binding MotherboardSummary}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding MotherboardLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="#71717A" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#E4E4E7" FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="PROCESSADOR, VRAM &amp; MEMÓRIA" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding CpuSummary}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding CpuLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="#71717A" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#E4E4E7" FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="#2E2E33" Margin="0,8" />
                            <ItemsControl ItemsSource="{Binding VideoAdapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#60A5FA" FontSize="12" />
                                            <TextBlock FontSize="12" Foreground="#E4E4E7">
                                                <Run Text="VRAM real: " Foreground="#71717A" />
                                                <Run Text="{Binding FormattedVram, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" · Driver " Foreground="#71717A" />
                                                <Run Text="{Binding DriverVersion, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="#2E2E33" Margin="0,8" />
                            <TextBlock Text="{Binding MemorySummary}" FontSize="13" FontWeight="Bold" Foreground="#F472B6" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding MemoryLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="#71717A" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#E4E4E7" FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="PENTES DE MEMÓRIA RAM POR SLOT (JEDEC)" FontSize="11" FontWeight="Bold" Foreground="#F472B6" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding RamModules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Slot}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Manufacturer}" Foreground="#A1A1AA" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedCapacity}" Foreground="#34D399" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Grid.Column="3" Text="{Binding Type}" Foreground="#E4E4E7" FontSize="12" />
                                        <TextBlock Grid.Column="4" Text="{Binding FormattedSpeed}" Foreground="#818CF8" FontSize="12" />
                                        <TextBlock Grid.Column="5" Text="{Binding PartNumber}" FontFamily="Consolas" Foreground="#71717A" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- SUB-ABA 4: EXPORTAR RELATÓRIO -->
        <Grid Grid.Row="3" Visibility="{Binding IsReportTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Command="{Binding CopySummaryCommand}" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                        Padding="14,9" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="📋 Copiar Resumo" />
                </Button>
                <Button Click="OnSaveHtmlReportClick" Background="#27272A" Foreground="#E4E4E7" FontWeight="SemiBold" FontSize="12"
                        Padding="14,9" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="🌐 Salvar HTML..." />
                </Button>
                <Button Click="OnSaveJsonReportClick" Background="#27272A" Foreground="#E4E4E7" FontWeight="SemiBold" FontSize="12"
                        Padding="14,9" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{}{ } Salvar JSON..." />
                </Button>
            </StackPanel>

            <Border Grid.Row="1" Background="#0F0F11" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Prévia anonimizada (seu usuário, nome do PC e pastas pessoais ficam ocultos como [usuário] e [nome do PC]):"
                               Foreground="#71717A" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ReportSummaryPreview, Mode=OneWay}" Background="Transparent" Foreground="#E4E4E7"
                             FontFamily="Consolas" FontSize="12" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>


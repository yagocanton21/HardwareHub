<UserControl x:Class="HardwareHub.Views.PostFormatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Foreground="#F4F4F5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="Assistente de Pós-Formatação" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                <TextBlock Text="Configure um PC recém-formatado em sequência segura: ponto de restauração, ativação, updates, bloatware, perfil e apps"
                           FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding CancelPostFormatCommand}" Visibility="{Binding IsRunningPostFormat, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource FlatButtonStyle}" Background="#DC2626" Foreground="#FFFFFF" Padding="14,8" Margin="0,0,8,0">
                    <TextBlock Text="⏹ Parar" FontSize="12" FontWeight="Bold" />
                </Button>
                <Button Command="{Binding RunPostFormatCommand}" IsEnabled="{Binding CanStartPostFormat}"
                        Style="{StaticResource FlatButtonStyle}" Background="#4F46E5" Foreground="#FFFFFF" Padding="16,8">
                    <TextBlock Text="🚀 Iniciar Pós-Formatação" FontSize="12" FontWeight="Bold" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                <!-- Resumo de Status + Ativação -->
            <Border Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding PostFormatSummary}" Foreground="#FAFAFA" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ActivationSummaryText, StringFormat='Licença: {0}'}" Foreground="#A5B4FC" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshActivationCommand}" Style="{StaticResource FlatButtonStyle}"
                                Background="#27272A" Foreground="#E4E4E7" Padding="12,6" BorderThickness="1" BorderBrush="#3F3F46" Margin="0,0,8,0">
                            <TextBlock Text="🔑 Checar Licença" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                        <Button Command="{Binding OpenWindowsUpdateCommand}" Style="{StaticResource FlatButtonStyle}"
                                Background="#27272A" Foreground="#E4E4E7" Padding="12,6" BorderThickness="1" BorderBrush="#3F3F46">
                            <TextBlock Text="🔄 Abrir Windows Update" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Seleção de Perfil e Kit -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Perfil de Otimização" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedValue="{Binding SelectedProfileId}" SelectedValuePath="Id"
                                  DisplayMemberPath="Nome" IsEnabled="{Binding CanStartPostFormat}"
                                  Background="#18181B" Foreground="#FAFAFA" BorderBrush="#3F3F46" Padding="8,6" />
                        <TextBlock Text="{Binding SelectedProfileSummary}" Foreground="#9CA3AF" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Todos os ajustes salvam backup antes de alterar o registro." Foreground="#71717A" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Kit de Programas (via Winget)" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding SoftwareKits}" SelectedValue="{Binding SelectedKitId}" SelectedValuePath="Id"
                                  DisplayMemberPath="Name" IsEnabled="{Binding CanStartPostFormat}"
                                  Background="#18181B" Foreground="#FAFAFA" BorderBrush="#3F3F46" Padding="8,6" />
                        <TextBlock Text="{Binding SelectedKitDescription}" Foreground="#9CA3AF" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedKitProgramsHeader}" Foreground="#A5B4FC" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,6" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding SelectedKitPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6"
                                            Padding="7,3" Margin="0,0,5,5">
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#E4E4E7" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Lista de Etapas -->
            <TextBlock Text="Etapas da Execução" Foreground="#E4E4E7" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding PostFormatSteps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsEnabled}" IsEnabled="{Binding DataContext.CanStartPostFormat, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Description}" Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Foreground="#A5B4FC" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{Binding StateColor}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>


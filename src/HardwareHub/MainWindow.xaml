<Window x:Class="HardwareHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HardwareHub.ViewModels"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Hardware HUB • Monitor &amp; Central de Aplicativos"
        Icon="Hardware_HUB.ico"
        Height="700" Width="1080"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Estilo base para botões da barra lateral -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#FAFAFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Cartões de Métricas -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#202023" />
            <Setter Property="BorderBrush" Value="#2E2E33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= BARRA LATERAL (SIDEBAR) ================= -->
        <Border Grid.Column="0" Background="#121214" BorderBrush="#27272A" BorderThickness="0,0,1,0">
            <Grid Margin="12,16,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Identidade do Hub -->
                <StackPanel Grid.Row="0" Margin="4,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Hardware_HUB.png" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HARDWARE" FontSize="11" FontWeight="Bold" Foreground="#818CF8" />
                            <TextBlock Text="HUB" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,-2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Monitor &amp; Central de Apps" FontSize="11" Foreground="#71717A" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Menu de Navegação -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="MENU PRINCIPAL" FontSize="11" FontWeight="Bold" Foreground="#52525B" Margin="8,0,0,8" />

                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Visão Geral" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Hardware">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Sensores &amp; Hardware" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Disks">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Saúde dos Discos" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Maintenance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛠️" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Manutenção &amp; Reparo" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="StressTest">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔥" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Estresse &amp; Bench (3D)" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Apps">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Baixar Programas" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Console / Logs" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Card de Informações do Sistema no rodapé da sidebar -->
                <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="💻" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SystemInfo.MachineName}" FontWeight="SemiBold" Foreground="#E4E4E7" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="{Binding SystemInfo.OsName}" Foreground="#71717A" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <Border Height="1" Background="#27272A" Margin="0,8,0,8" />
                        <StackPanel>
                            <TextBlock Text="Tempo de atividade (Uptime):" Foreground="#71717A" FontSize="10" />
                            <TextBlock Text="{Binding SystemInfo.FormattedUptime}" ToolTip="{Binding SystemInfo.TaskMgrUptime}"
                                       Foreground="#818CF8" FontSize="12" FontWeight="Bold" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= ÁREA DE CONTEÚDO PRINCIPAL ================= -->
        <Grid Grid.Column="1" Margin="22,14,22,14">

            <!-- ================= TELA 1: VISÃO GERAL (DASHBOARD) ================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsDashboardActive, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Painel de Controle" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Monitoramento de telemetria em tempo real e atalhos rápidos" FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Banner de Atualização Automática Disponível -->
                    <Border Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                            Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="10"
                            Padding="16,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀 Nova versão disponível!" FontWeight="Bold" Foreground="#818CF8" FontSize="14" />
                                    <Border Background="#312E81" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding LatestVersionText}" FontSize="11" Foreground="#C7D2FE" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding UpdateChangelogSummary}" Foreground="#A5B4FC" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Value="{Binding UpdateDownloadProgress}" Maximum="100" Height="4" Margin="0,8,0,0"
                                             Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}"
                                             Foreground="#818CF8" Background="#312E81" BorderThickness="0" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ApplyUpdateCommand}" IsEnabled="{Binding CanApplyUpdate}"
                                    Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                    Padding="16,8" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding UpdateButtonText}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Grade de Cartões de Destaque -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Cartão CPU -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#312E81" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                        <TextBlock Text="🔥" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="PROCESSADOR (CPU)" FontSize="11" FontWeight="Bold" Foreground="#818CF8" />
                                        <TextBlock Text="{Binding Cpu.Name}" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Uso" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock Text="{Binding Cpu.FormattedUsage}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Temperatura" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock Text="{Binding Cpu.FormattedTemperature}" FontSize="24" FontWeight="Bold" Foreground="#F97316" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Grid.Row="2" Value="{Binding Cpu.UsagePercentage}" Maximum="100" Height="6" Margin="0,8,0,4"
                                             Foreground="#6366F1" Background="#27272A" BorderThickness="0" />

                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <TextBlock Text="Clock: " FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding Cpu.FormattedClock}" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Cartão GPU -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="10,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#065F46" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                        <TextBlock Text="🎮" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="PLACA DE VÍDEO (GPU)" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                                        <TextBlock Text="{Binding Gpu.Name}" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Uso" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock Text="{Binding Gpu.FormattedUsage}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Temperatura" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock Text="{Binding Gpu.FormattedTemperature}" FontSize="24" FontWeight="Bold" Foreground="#10B981" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Grid.Row="2" Value="{Binding Gpu.UsagePercentage}" Maximum="100" Height="6" Margin="0,8,0,4"
                                             Foreground="#10B981" Background="#27272A" BorderThickness="0" />

                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <TextBlock Text="VRAM: " FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding Gpu.FormattedVram}" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Cartão Memória RAM -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#831843" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                        <TextBlock Text="⚡" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="MEMÓRIA RAM" FontSize="11" FontWeight="Bold" Foreground="#F472B6" />
                                        <TextBlock Text="Memória do Sistema" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Uso" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock Text="{Binding Ram.FormattedUsage}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Capacidade" FontSize="11" Foreground="#A1A1AA" />
                                        <TextBlock Text="{Binding Ram.FormattedCapacity}" FontSize="15" FontWeight="SemiBold" Foreground="#E4E4E7" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Grid.Row="2" Value="{Binding Ram.UsagePercentage}" Maximum="100" Height="6" Margin="0,8,0,4"
                                             Foreground="#EC4899" Background="#27272A" BorderThickness="0" />

                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <TextBlock Text="Livre: " FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding Ram.FreeGb, StringFormat={}{0:F1} GB}" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Cartão Armazenamento Rápido -->
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#1E3A8A" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                        <TextBlock Text="💾" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="DISCOS DE ARMAZENAMENTO" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" />
                                        <TextBlock Text="Unidades Locais" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" />
                                    </StackPanel>
                                </StackPanel>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Disks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <Grid>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" />
                                                    <TextBlock Text="{Binding FormattedSpace}" FontSize="11" Foreground="#71717A" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ProgressBar Value="{Binding UsagePercentage}" Maximum="100" Height="5" Margin="0,4,0,0"
                                                             Foreground="#3B82F6" Background="#27272A" BorderThickness="0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Banner Informativo de Driver de Sensores (PawnIO) -->
                    <Border Background="#1C1917" BorderBrush="#EAB308" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14"
                            Visibility="{Binding IsPawnIOMissing, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="⚡ Ativar Leitura Nativa de Temperatura (Driver PawnIO)" FontSize="13" FontWeight="Bold" Foreground="#FACC15" />
                                <TextBlock Text="O driver seguro PawnIO (usado pelo FanControl e LibreHardwareMonitor) é necessário para desbloquear os sensores térmicos da CPU."
                                           FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding InstallPawnIOCommand}"
                                    Background="#CA8A04" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                                    Padding="14,7" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Instalar Driver ➔" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Banner de Ação Rápida para o Downloader -->
                    <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="Instalador Automático de Programas" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="Baixe navegadores, Discord, Steam, VS Code e ferramentas essenciais com 1 clique usando o catálogo do winget."
                                           FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding NavigateCommand}" CommandParameter="Apps"
                                    Background="#6366F1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"
                                    Padding="18,10" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Abrir Catálogo de Apps ➔" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= TELA 2: SENSORES & HARDWARE DETALHADO ================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsHardwareActive, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Sensores &amp; Telemetria do Sistema" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Leitura contínua de frequências, temperaturas e utilização dos componentes" FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,20" />

                    <!-- Detalhes do Processador -->
                    <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="PROCESSADOR DETALHADO" FontSize="12" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Modelo" FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding Cpu.Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Núcleos / Threads" FontSize="11" Foreground="#71717A" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Cpu.Cores}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text="C / " FontSize="13" Foreground="#71717A" />
                                        <TextBlock Text="{Binding Cpu.Threads}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text="T" FontSize="13" Foreground="#71717A" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Temperatura da CPU" FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding Cpu.FormattedTemperature}" FontSize="16" FontWeight="Bold" Foreground="#F97316" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Carga Atual" FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding Cpu.FormattedUsage}" FontSize="16" FontWeight="Bold" Foreground="#818CF8" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar Value="{Binding Cpu.UsagePercentage}" Maximum="100" Height="8" Foreground="#6366F1" Background="#27272A" BorderThickness="0" />
                        </StackPanel>
                    </Border>

                    <!-- Detalhes da Placa de Vídeo -->
                    <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="PLACA GRÁFICA DETALHADA" FontSize="12" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Modelo da GPU" FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding Gpu.Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Uso do Chip" FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding Gpu.FormattedUsage}" FontSize="16" FontWeight="Bold" Foreground="#34D399" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Temperatura da GPU" FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding Gpu.FormattedTemperature}" FontSize="16" FontWeight="Bold" Foreground="#10B981" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Memória VRAM" FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding Gpu.FormattedVram}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar Value="{Binding Gpu.UsagePercentage}" Maximum="100" Height="8" Foreground="#10B981" Background="#27272A" BorderThickness="0" />
                        </StackPanel>
                    </Border>

                    <!-- Detalhes das Unidades de Disco -->
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ARMAZENAMENTO &amp; VOLUMES" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Disks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" />
                                                    <TextBlock Text="{Binding DriveLetter, StringFormat={}Montado em {0}}" FontSize="11" Foreground="#71717A" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                                                    <ProgressBar Value="{Binding UsagePercentage}" Maximum="100" Height="8" Foreground="#3B82F6" Background="#27272A" BorderThickness="0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UsagePercentage, StringFormat={}{0:F0}% em uso}" FontWeight="Bold" Foreground="#E4E4E7" FontSize="12" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding FreeGb, StringFormat={}{0:F0} GB livres}" FontSize="11" Foreground="#71717A" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= TELA 3: SAÚDE & DIAGNÓSTICO DE DISCOS (S.M.A.R.T.) ================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsDisksActive, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Saúde &amp; Diagnóstico de Discos" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Telemetria S.M.A.R.T., temperatura, desgaste de SSDs e teste de velocidade sequencial" FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding RefreshDisksCommand}"
                                IsEnabled="{Binding CanRefreshDisks}"
                                Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                                Padding="14,8" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{Binding RefreshDisksButtonText}" />
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PhysicalDisks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Topo: Modelo, Letras e Selo de Saúde -->
                                        <Grid Grid.Row="0" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Model}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    <Border Background="#27272A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayInterface}" FontSize="11" FontWeight="Bold" Foreground="#818CF8" />
                                                    </Border>
                                                    <Border Background="#27272A" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MediaType}" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="Unidades: " FontSize="12" Foreground="#71717A" />
                                                    <TextBlock Text="{Binding DriveLetters}" FontSize="12" Foreground="#A1A1AA" FontWeight="SemiBold" />
                                                    <TextBlock Text="  •  Capacidade: " FontSize="12" Foreground="#71717A" />
                                                    <TextBlock Text="{Binding FormattedCapacity}" FontSize="12" Foreground="#A1A1AA" FontWeight="SemiBold" />
                                                    <TextBlock Text="  •  Escrita: " FontSize="12" Foreground="#71717A" />
                                                    <TextBlock Text="{Binding FormattedWritten}" FontSize="12" Foreground="#F59E0B" FontWeight="SemiBold" />
                                                    <TextBlock Text="  •  Leitura: " FontSize="12" Foreground="#71717A" />
                                                    <TextBlock Text="{Binding FormattedRead}" FontSize="12" Foreground="#60A5FA" FontWeight="SemiBold" />
                                                    <TextBlock Text="  •  Ligado: " FontSize="12" Foreground="#71717A" />
                                                    <TextBlock Text="{Binding FormattedPowerOnCount}" FontSize="12" Foreground="#A1A1AA" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Selo de Saúde -->
                                            <Border Grid.Column="1" Background="#18181B" BorderBrush="{Binding HealthColor}" BorderThickness="1"
                                                    CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="● " Foreground="{Binding HealthColor}" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding HealthBadgeText}" FontWeight="Bold" Foreground="{Binding HealthColor}" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Linha 2: Métricas Rápidas S.M.A.R.T. -->
                                        <Grid Grid.Row="1" Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="#18181B" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="Temperatura" FontSize="11" Foreground="#71717A" />
                                                    <TextBlock Text="{Binding FormattedTemperature}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Background="#18181B" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="Tempo em Atividade" FontSize="11" Foreground="#71717A" />
                                                    <TextBlock Text="{Binding FormattedPowerOnHours}" FontSize="14" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Background="#18181B" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="Velocidade de Leitura" FontSize="11" Foreground="#71717A" />
                                                    <TextBlock Text="{Binding FormattedReadSpeed}" FontSize="18" FontWeight="Bold" Foreground="#60A5FA" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="3" Background="#18181B" CornerRadius="8" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="Velocidade de Gravação" FontSize="11" Foreground="#71717A" />
                                                    <TextBlock Text="{Binding FormattedWriteSpeed}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Linha 3: Barra de Ação de Benchmark -->
                                        <Border Grid.Row="2" Background="#18181B" CornerRadius="8" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Benchmark Sequencial de Desempenho (64 MB)" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" />
                                                    <TextBlock Text="{Binding SpeedStatusText}" FontSize="11" Foreground="#71717A" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Command="{Binding DataContext.BenchmarkDiskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                                                        Padding="14,6" BorderThickness="0" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="⚡ Medir Velocidade Real" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= TELA 4: MANUTENÇÃO & REPARO DO WINDOWS ================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsMaintenanceActive, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Central de Manutenção &amp; Reparo do Windows" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Execute verificações e reparos com 1 clique ou clique em '🖥️ CMD' para acompanhar o progresso em tempo real numa janela externa" FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,20" />

                    <ItemsControl ItemsSource="{Binding MaintenanceTools}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="12"
                                        Width="380" Margin="0,0,14,14" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Topo: Ícone, Título e Status -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#27272A" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Descrição -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="#71717A" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,14" />

                                        <!-- Ação e Progresso -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" IsIndeterminate="{Binding IsRunning}" Height="4"
                                                         Foreground="#6366F1" Background="#27272A" BorderThickness="0"
                                                         VerticalAlignment="Center" Margin="0,0,12,0"
                                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.RunMaintenanceInCmdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanExecute}"
                                                        Background="#27272A" Foreground="#E4E4E7" FontWeight="SemiBold" FontSize="11"
                                                        Padding="10,8" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Abrir em Janela do Prompt de Comando (CMD) para ver o progresso em tempo real">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="🖥️ CMD" />
                                                </Button>
                                                <Button Command="{Binding DataContext.RunMaintenanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanExecute}"
                                                        Background="{Binding AccentColor}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                                        Padding="14,8" BorderThickness="0" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="{Binding ActionButtonText}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= TELA 5: BAIXAR PROGRAMAS (HUB CENTRAL) ================= -->
            <Grid Visibility="{Binding IsAppsActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header e Verificação -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Central de Programas" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Instale os principais navegadores, ferramentas e jogos de forma silenciosa e segura" 
                                   FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Botão Importar Lista Winget -->
                        <Button Command="{Binding ImportWingetFileCommand}"
                                Background="#312E81" Foreground="#C7D2FE" FontWeight="SemiBold" FontSize="12"
                                Padding="14,9" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="borderImp" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="borderImp" Property="Background" Value="#4338CA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥 " Margin="0,0,4,0" />
                                <TextBlock Text="Importar Lista Winget" />
                            </StackPanel>
                        </Button>

                        <!-- Botão Instalar Todos os Importados em Lote -->
                        <Button Command="{Binding InstallAllImportedCommand}"
                                Visibility="{Binding HasImportedApps, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{Binding CanBatchInstall}"
                                Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                                Padding="14,9" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="borderBatch" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="borderBatch" Property="Background" Value="#10B981" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="borderBatch" Property="Background" Value="#27272A" />
                                            <Setter Property="Foreground" Value="#71717A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ " Margin="0,0,4,0" />
                                <TextBlock Text="Instalar Todos da Lista" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RefreshSoftwareStatusCommand}"
                                Background="#27272A" Foreground="#E4E4E7" FontWeight="SemiBold" FontSize="12"
                                Padding="16,9" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#3F3F46" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{Binding RefreshButtonText}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Linha 1: Campo de Busca Moderno com Botão de Busca no Winget Global -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Padding="14,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                     FontSize="13" VerticalContentAlignment="Center" CaretBrush="#FFFFFF" Padding="0,6">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchOnlineCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="1" Text="Pesquisar por nome do programa (ex: WhatsApp, Telegram, GIMP, Blender)..."
                                       FontSize="13" Foreground="#52525B" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchFilter}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Column="2" Command="{Binding SearchOnlineCommand}"
                                    Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"
                                    Padding="12,6" BorderThickness="0" Cursor="Hand" Margin="6,2,0,2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="sBtn" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="sBtn" Property="Background" Value="#6366F1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="🌐 Buscar no Winget" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Barra de progresso para busca online -->
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Background="#27272A" Foreground="#6366F1" BorderThickness="0"
                                 Visibility="{Binding IsSearchingOnline, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0" />
                </Grid>

                <!-- Linha 2: Filtros de Categoria em WrapPanel Interativo com Seleção Direta -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,16">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="pillBorder" Background="#202023" BorderBrush="#2E2E33" BorderThickness="1"
                                                CornerRadius="16" Padding="14,6" Margin="0,0,8,8" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="pillBorder" Property="Background" Value="#4F46E5" />
                                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#6366F1" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter Property="Foreground" Value="#A1A1AA" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#6366F1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Linha 3: Grid Balanceado ou Estado Vazio com Busca Global -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Card quando nenhum programa local for encontrado -->
                        <Border Background="#202023" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="12" Padding="28" Margin="0,0,12,16"
                                Visibility="{Binding HasNoLocalResults, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Nenhum programa no catálogo pré-carregado" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <TextBlock Text="Deseja pesquisar entre os milhares de programas oficiais disponíveis no catálogo mundial do Windows (Winget)?" 
                                           FontSize="13" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,6,0,18" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Command="{Binding SearchOnlineCommand}"
                                        Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"
                                        Padding="20,10" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#6366F1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍 Pesquisar " />
                                        <TextBlock Text="{Binding SearchFilter, StringFormat='&quot;{0}&quot;'}" FontWeight="Bold" />
                                        <TextBlock Text=" no Winget Online" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding FilteredSoftware}" Margin="0,0,6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#202023" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="12"
                                        Margin="0,0,12,12" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Topo do Card: Ícone, Nome, Publisher e Categoria -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="#27272A" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding AppEmoji}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="#71717A" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#27272A" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                            </Border>
                                        </Grid>

                                        <!-- Descrição -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="#A1A1AA"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" LineHeight="17" Margin="0,0,0,12" />

                                        <!-- Rodapé: Status e Botão de Ação -->
                                        <StackPanel Grid.Row="2">
                                            <!-- Indicador de Progresso (quando instalando) -->
                                            <ProgressBar IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue}" Maximum="100"
                                                         Height="4" Margin="0,0,0,8" Background="#27272A" Foreground="#6366F1" BorderThickness="0"
                                                         Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />

                                            <Grid>
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" />

                                                <Button HorizontalAlignment="Right" Padding="16,7" FontSize="12" FontWeight="SemiBold"
                                                        Command="{Binding DataContext.InstallAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanInstall}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#4F46E5" />
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsEnabled" Value="False">
                                                                                <Setter TargetName="btnBorder" Property="Background" Value="#27272A" />
                                                                                <Setter Property="Foreground" Value="#71717A" />
                                                                                <Setter Property="Cursor" Value="Arrow" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="btnBorder" Property="Background" Value="#6366F1" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                        <Setter Property="Text" Value="✓ Instalado" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                                        <Setter Property="Text" Value="Baixando..." />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CanInstall}" Value="True">
                                                                        <Setter Property="Text" Value="Baixar ➔" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

            <!-- ================= TELA: TESTE DE ESTRESSE & BENCHMARK 3D ================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsStressTestActive, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,0,24">
                    <!-- Cabeçalho -->
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Teste de Estresse &amp; Benchmark 3D" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Validação de limite térmico, estabilidade de cálculo e renderização gráfica em tempo real" FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Alerta Térmico em Vermelho caso a CPU ultrapasse 85°C -->
                    <Border Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                            Visibility="{Binding IsThermalWarning, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="ALERTA: LIMITE TÉRMICO ELEVADO" FontWeight="Bold" Foreground="#FCA5A5" FontSize="13" />
                                <TextBlock Text="O processador atingiu temperatura crítica (> 85 °C). O teste pode ser pausado para proteger o hardware." Foreground="#FECACA" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Duas Colunas: CPU à esquerda, GPU 3D à direita -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- COLUNA 1: TESTE DE ESTRESSE E BENCHMARK DE CPU -->
                        <Border Grid.Column="0" Margin="0,0,10,0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#312E81" Margin="0,0,12,0">
                                        <TextBlock Text="🔥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ESTRESSE DE PROCESSADOR (CPU)" FontWeight="Bold" Foreground="#818CF8" FontSize="13" />
                                        <TextBlock Text="{Binding Cpu.Name}" Foreground="#E4E4E7" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Cards de Telemetria do Teste -->
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <Border Background="#27272A" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Carga Atual" Foreground="#A1A1AA" FontSize="11" />
                                            <TextBlock Text="{Binding Cpu.FormattedUsage}" FontWeight="Bold" Foreground="#818CF8" FontSize="22" Margin="0,4,0,0" />
                                            <ProgressBar Value="{Binding Cpu.UsagePercentage}" Maximum="100" Height="4" Margin="0,6,0,0" Foreground="#818CF8" Background="#3F3F46" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#27272A" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Temperatura da CPU" Foreground="#A1A1AA" FontSize="11" />
                                            <TextBlock Text="{Binding Cpu.FormattedTemperature}" FontWeight="Bold" Foreground="#F59E0B" FontSize="22" Margin="0,4,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="Pico: " Foreground="#71717A" FontSize="10" />
                                                <TextBlock Text="{Binding CpuMaxObservedTemp, StringFormat={}{0:F0} °C}" FontWeight="SemiBold" Foreground="#F59E0B" FontSize="10" />
                                                <TextBlock Text="  ·  Início: " Foreground="#71717A" FontSize="10" />
                                                <TextBlock Text="{Binding CpuStartTemp, StringFormat={}{0:F0} °C}" Foreground="#A1A1AA" FontSize="10" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Resultados de Benchmark -->
                                <Border Background="#232326" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="#27272A" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="BENCHMARK DE DESEMPENHO" FontWeight="SemiBold" Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right" Background="#2E1065" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="Escala CPU-Z 17.01" Foreground="#C084FC" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                        </DockPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Single-Thread (1 Núcleo)" Foreground="#E4E4E7" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding SingleCoreScore, StringFormat={}{0:F1}}" FontWeight="Bold" Foreground="#60A5FA" FontSize="13" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Multi-Thread (Todos os Núcleos)" Foreground="#E4E4E7" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding MultiCoreScore, StringFormat={}{0:F1}}" FontWeight="Bold" Foreground="#A78BFA" FontSize="13" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Multi Thread Ratio" Foreground="#71717A" FontSize="11" />
                                            <TextBlock Grid.Column="1" Text="{Binding MultiThreadRatio, StringFormat={}{0:F2}}" FontWeight="SemiBold" Foreground="#34D399" FontSize="12" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Tempo e Status -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="Tempo em teste: " Foreground="#71717A" FontSize="12" />
                                    <TextBlock Text="{Binding CpuStressElapsed}" FontWeight="Bold" Foreground="#E4E4E7" FontSize="12" />
                                </StackPanel>

                                <!-- Botões de Ação do CPU -->
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Margin="0,0,4,0" Command="{Binding StartCpuStressCommand}"
                                                Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                                                Padding="10,10" BorderThickness="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔥" Margin="0,0,6,0" />
                                                <TextBlock Text="Estresse (100%)" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Margin="4,0,0,0" Command="{Binding StartCpuBenchmarkCommand}"
                                                Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                                                Padding="10,10" BorderThickness="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡" Margin="0,0,6,0" />
                                                <TextBlock Text="Benchmark" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Button Command="{Binding StopCpuTestCommand}"
                                            Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                                            Padding="10,9" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="🛑 Parar Teste de CPU" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- COLUNA 2: RENDERIZAÇÃO 3D DA GPU -->
                        <Border Grid.Column="1" Margin="10,0,0,0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#064E3B" Margin="0,0,12,0">
                                        <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="RENDERIZAÇÃO 3D EM TEMPO REAL (GPU)" FontWeight="Bold" Foreground="#34D399" FontSize="13" />
                                        <TextBlock Text="{Binding Gpu.Name}" Foreground="#E4E4E7" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Viewport 3D -->
                                <Border Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Height="190" Margin="0,0,0,14" ClipToBounds="True">
                                    <Grid>
                                        <Viewport3D>
                                            <Viewport3D.Camera>
                                                <PerspectiveCamera Position="0,0,6.5" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="45" />
                                            </Viewport3D.Camera>
                                            <ModelVisual3D>
                                                <ModelVisual3D.Content>
                                                    <Model3DGroup>
                                                        <AmbientLight Color="#333333" />
                                                        <DirectionalLight Color="#818CF8" Direction="-1,-1,-2" />
                                                        <DirectionalLight Color="#34D399" Direction="1,1,-1" />
                                                        <DirectionalLight Color="#F59E0B" Direction="0,-2,-1" />

                                                        <GeometryModel3D Geometry="{Binding TorusMesh}">
                                                            <GeometryModel3D.Material>
                                                                <MaterialGroup>
                                                                    <DiffuseMaterial>
                                                                        <DiffuseMaterial.Brush>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                <GradientStop Color="#6366F1" Offset="0" />
                                                                                <GradientStop Color="#A855F7" Offset="0.5" />
                                                                                <GradientStop Color="#06B6D4" Offset="1" />
                                                                            </LinearGradientBrush>
                                                                        </DiffuseMaterial.Brush>
                                                                    </DiffuseMaterial>
                                                                    <SpecularMaterial SpecularPower="85">
                                                                        <SpecularMaterial.Brush>
                                                                            <SolidColorBrush Color="#FFFFFF" />
                                                                        </SpecularMaterial.Brush>
                                                                    </SpecularMaterial>
                                                                </MaterialGroup>
                                                            </GeometryModel3D.Material>
                                                            <GeometryModel3D.Transform>
                                                                <Transform3DGroup>
                                                                    <RotateTransform3D>
                                                                        <RotateTransform3D.Rotation>
                                                                            <AxisAngleRotation3D x:Name="TorusRot" Axis="1,0.8,0.4" Angle="0" />
                                                                        </RotateTransform3D.Rotation>
                                                                    </RotateTransform3D>
                                                                </Transform3DGroup>
                                                            </GeometryModel3D.Transform>
                                                        </GeometryModel3D>
                                                    </Model3DGroup>
                                                </ModelVisual3D.Content>
                                            </ModelVisual3D>
                                            <Viewport3D.Triggers>
                                                <EventTrigger RoutedEvent="Viewport3D.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="TorusRot" Storyboard.TargetProperty="Angle"
                                                                             From="0" To="360" Duration="0:0:5" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Viewport3D.Triggers>
                                        </Viewport3D>

                                        <!-- Badge de FPS no topo direito do 3D -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="#CC18181B" CornerRadius="6" Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="FPS: " Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding GpuRenderFps}" FontWeight="Bold" Foreground="#10B981" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Telemetria da GPU -->
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <Border Background="#27272A" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Carga da GPU" Foreground="#A1A1AA" FontSize="11" />
                                            <TextBlock Text="{Binding Gpu.FormattedUsage}" FontWeight="Bold" Foreground="#34D399" FontSize="20" Margin="0,4,0,0" />
                                            <ProgressBar Value="{Binding Gpu.UsagePercentage}" Maximum="100" Height="4" Margin="0,6,0,0" Foreground="#34D399" Background="#3F3F46" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#27272A" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Temperatura da GPU" Foreground="#A1A1AA" FontSize="11" />
                                            <TextBlock Text="{Binding Gpu.FormattedTemperature}" FontWeight="Bold" Foreground="#F59E0B" FontSize="20" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding GpuRenderElapsed, StringFormat={}Tempo: {0}}" Foreground="#71717A" FontSize="10" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Botões de Ação do GPU -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Margin="0,0,4,0" Command="{Binding StartGpuRenderCommand}"
                                            Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                                            Padding="10,10" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎮" Margin="0,0,6,0" />
                                            <TextBlock Text="Iniciar Render 3D" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1" Margin="4,0,0,0" Command="{Binding StopGpuRenderCommand}"
                                            Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                                            Padding="10,10" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="🛑 Parar Render" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= TELA 4: CONSOLE / LOGS ================= -->
            <Grid Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Console de Operações" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Logs em tempo real de downloads do winget, telemetria de sensores e eventos" FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding CheckForUpdatesCommand}"
                                Background="#312E81" Foreground="#C7D2FE" FontWeight="SemiBold" FontSize="12"
                                Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="🔄 Buscar Atualizações" />
                        </Button>
                        <Button Command="{Binding ClearLogsCommand}"
                                Background="#27272A" Foreground="#E4E4E7" FontWeight="SemiBold" FontSize="12"
                                Padding="14,8" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="🗑️ Limpar Console" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#0F0F11" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14">
                    <TextBox Text="{Binding LogOutput, Mode=OneWay}" 
                             Background="Transparent" Foreground="#10B981" BorderThickness="0"
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>

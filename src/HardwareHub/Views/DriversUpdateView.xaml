<UserControl x:Class="HardwareHub.Views.DriversUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="#FAFAFA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#202023" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderBrush" Value="#2E2E33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#FAFAFA" />
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#312E81" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER FIXO -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="Drivers &amp; Windows Update" FontSize="24" FontWeight="Bold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                <TextBlock Text="Diagnostique erros de dispositivos PnP, exporte drivers de terceiros e gerencie atualizações do Windows"
                           FontSize="12.5" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="📥 Importar Drivers"
                        Click="OnImportDriversClick"
                        IsEnabled="{Binding CanRunDriverBackup}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1"
                        FontSize="12.5" FontWeight="SemiBold" Padding="14,9" Margin="0,0,8,0" />
                <Button Content="💾 Backup Drivers"
                        Click="OnBackupDriversClick"
                        IsEnabled="{Binding CanRunDriverBackup}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1"
                        FontSize="12.5" FontWeight="SemiBold" Padding="14,9" Margin="0,0,8,0" />
                <Button Content="🔄 Reanalisar Drivers"
                        Command="{Binding RefreshHardwareAndDriversCommand}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#4F46E5" Foreground="#FFFFFF"
                        FontSize="12.5" FontWeight="SemiBold" Padding="14,9" />
            </StackPanel>
        </Grid>

        <!-- SUB-ABAS -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="🩺 Saúde &amp; Suporte"
                    Style="{StaticResource SubTabButtonStyle}"
                    Tag="{Binding IsOverviewTabActive}"
                    Command="{Binding SetSubTabCommand}" CommandParameter="Overview" />
            <Button Content="🛡 Windows Update"
                    Style="{StaticResource SubTabButtonStyle}"
                    Tag="{Binding IsUpdatesTabActive}"
                    Command="{Binding SetSubTabCommand}" CommandParameter="Updates" />
            <Button Content="📋 Inventário Completo"
                    Style="{StaticResource SubTabButtonStyle}"
                    Tag="{Binding IsInventoryTabActive}"
                    Command="{Binding SetSubTabCommand}" CommandParameter="Inventory" />
        </WrapPanel>

        <!-- STATUS BANNER -->
        <Border Grid.Row="2" Background="#1C1C21" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusBanner}" Foreground="#D4D4D8" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="✖ Cancelar"
                        Command="{Binding CancelTaskCommand}"
                        Visibility="{Binding IsAnyBusy, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#7F1D1D" Foreground="#FEE2E2"
                        FontSize="12" FontWeight="SemiBold" Padding="12,6" Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- ABA 1: SAÚDE & SUPORTE -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                      Visibility="{Binding IsOverviewTabActive, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Cards resumo: Placa-mãe + Atalhos -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="PLACA-MÃE &amp; BIOS" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" />
                            <TextBlock Text="{Binding BoardSummaryText}" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,6,0,10" TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button Content="🌐 Portal Oficial do Fabricante"
                                        Command="{Binding OpenBoardSupportCommand}"
                                        Visibility="{Binding HasBoardSupportUrl, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Background="#27272A" Foreground="#A5B4FC" BorderBrush="#3F3F46" BorderThickness="1"
                                        FontSize="12" FontWeight="SemiBold" Padding="12,7" Margin="0,0,8,6" />
                                <Button Content="🪟 Gerenciador de Dispositivos"
                                        Command="{Binding OpenDeviceManagerCommand}"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1"
                                        FontSize="12" FontWeight="SemiBold" Padding="12,7" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="PLACA DE VÍDEO (GPU)" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" />
                            <ItemsControl ItemsSource="{Binding Gpus}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                                                <TextBlock FontSize="12" Foreground="#A1A1AA">
                                                    <Run Text="Versão: " />
                                                    <Run Text="{Binding DisplayDriverVersion, Mode=OneWay}" Foreground="#A5B4FC" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="⬇ Drivers"
                                                    Command="{Binding DataContext.OpenGpuSupportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding SupportUrl}"
                                                    Style="{StaticResource FlatButtonStyle}"
                                                    Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1"
                                                    FontSize="11.5" FontWeight="SemiBold" Padding="10,6" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- DISPOSITIVOS COM ERRO PnP -->
                <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dispositivos com Problema ou Driver Genérico" FontSize="15" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="⚙ Drivers Opcionais (Windows)"
                                    Command="{Binding OpenWindowsUpdateDriversCommand}"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1"
                                    FontSize="12" FontWeight="SemiBold" Padding="12,7" />
                        </Grid>

                        <Border Background="#142923" BorderBrush="#065F46" BorderThickness="1" CornerRadius="8" Padding="14"
                                Visibility="{Binding HasNoProblems, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="✅ Nenhum erro Plug &amp; Play ou driver básico de vídeo genérico detectado no sistema."
                                       Foreground="#6EE7B7" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding DriverProblems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#202026" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Device}" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="#FCD34D" Margin="0,3,0,2" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Tip}" FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding HardwareId}" FontSize="11" Foreground="#71717A" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{Binding SeverityColor}" CornerRadius="6" Padding="10,5" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding SeverityLabel}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ABA 2: WINDOWS UPDATE -->
        <Grid Grid.Row="3" Visibility="{Binding IsUpdatesTabActive, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🔍 Buscar Atualizações"
                                Command="{Binding SearchUpdatesCommand}"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#4F46E5" Foreground="#FFFFFF"
                                FontSize="12.5" FontWeight="SemiBold" Padding="14,8" Margin="0,0,8,0" />
                        <Button Content="{Binding SelectAllUpdatesLabel}"
                                Command="{Binding ToggleSelectAllUpdatesCommand}"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1"
                                FontSize="12.5" FontWeight="SemiBold" Padding="14,8" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#78350F" CornerRadius="6" Padding="10,6" Margin="0,0,8,0"
                                Visibility="{Binding IsRebootPending, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⚠ Reinicialização pendente" Foreground="#FEF3C7" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <Button Content="{Binding InstallUpdatesButtonLabel}"
                                Command="{Binding InstallSelectedUpdatesCommand}"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#059669" Foreground="#FFFFFF"
                                FontSize="12.5" FontWeight="SemiBold" Padding="14,8" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <ItemsControl ItemsSource="{Binding WindowsUpdates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,0">
                                            <Run Text="{Binding KbId, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding FormattedSize, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{Binding CategoryColor}" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryLabel}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ABA 3: INVENTÁRIO COMPLETO -->
        <Grid Grid.Row="3" Visibility="{Binding IsInventoryTabActive, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding DriverSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#111114" Foreground="#FAFAFA" BorderBrush="#3F3F46" BorderThickness="1"
                             Padding="10,7" FontSize="12.5" Margin="0,0,10,0"
                             ToolTip="Filtrar por nome do dispositivo, fabricante ou versão" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ClassFilters}" SelectedItem="{Binding DriverClassFilter}"
                              Margin="0,0,10,0" Padding="8,6" />
                    <CheckBox Grid.Column="2" Content="Somente não assinados" IsChecked="{Binding ShowOnlyUnsigned}"
                              Foreground="#E4E4E7" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <ItemsControl ItemsSource="{Binding FilteredDrivers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Device}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,0" TextWrapping="Wrap">
                                            <Run Text="{Binding ClassLabel, Mode=OneWay}" Foreground="#A5B4FC" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding Vendor, Mode=OneWay}" />
                                            <Run Text=" • v" />
                                            <Run Text="{Binding DisplayVersion, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding Date, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{Binding SignatureColor}" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SignatureLabel}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

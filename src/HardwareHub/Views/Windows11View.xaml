<UserControl x:Class="HardwareHub.Views.Windows11View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="#FAFAFA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER FIXO -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="Compatibilidade Windows 11" FontSize="24" FontWeight="Bold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                <TextBlock Text="Verifique todos os 10 requisitos oficiais da Microsoft: TPM 2.0, UEFI, Secure Boot, CPU, RAM e instruções SSE4.2/POPCNT (24H2+)"
                           FontSize="12.5" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="🛡 Abrir tpm.msc"
                        Command="{Binding OpenTpmConsoleCommand}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1"
                        FontSize="12.5" FontWeight="SemiBold" Padding="12,9" Margin="0,0,8,0" />
                <Button Content="💻 msinfo32"
                        Command="{Binding OpenMsInfoCommand}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1"
                        FontSize="12.5" FontWeight="SemiBold" Padding="12,9" Margin="0,0,8,0" />
                <Button Content="🔍 Verificar Agora"
                        Command="{Binding VerifyCommand}"
                        Style="{StaticResource FlatButtonStyle}"
                        Background="#4F46E5" Foreground="#FFFFFF"
                        FontSize="12.5" FontWeight="SemiBold" Padding="14,9" />
            </StackPanel>
        </Grid>

        <!-- VEREDICTO & STATUS -->
        <Border Grid.Row="1" Background="#1C1C21" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StatusBanner}" Foreground="#FAFAFA" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SummarySubtitle}" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,0"
                               Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{Binding Report.VerdictColor, FallbackValue=#3F3F46}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center"
                        Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                    <TextBlock Foreground="#FFFFFF" FontSize="12" FontWeight="Bold">
                        <Run Text="{Binding Report.PassedCount, Mode=OneWay}" />
                        <Run Text="/" />
                        <Run Text="{Binding Report.Items.Count, Mode=OneWay}" />
                        <Run Text=" OK" />
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- LISTA DE REQUISITOS -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Requirements}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                                    <TextBlock FontSize="12.5" Foreground="#A5B4FC" Margin="0,3,0,2" TextWrapping="Wrap">
                                        <Run Text="Encontrado: " Foreground="#71717A" />
                                        <Run Text="{Binding Found, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Recommendation}" FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="6" Padding="10,5" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

